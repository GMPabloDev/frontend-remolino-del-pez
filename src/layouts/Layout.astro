---
import "../styles/global.css";

interface Props {
	description?: string;
	referrerPolicy?: string;
	robots?: string;
	title?: string;
}

const {
	description = "Consulta la carta pública de El Molino del Pez.",
	referrerPolicy,
	robots,
	title = "El Molino del Pez · Menú",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {robots ? <meta name="robots" content={robots} /> : null}
    {referrerPolicy ? <meta name="referrer" content={referrerPolicy} /> : null}
    <meta name="theme-color" content="#12324a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      document.addEventListener("astro:hydration-error", (event) => {
        const island = event.target;
        if (!(island instanceof HTMLElement)) return;

        const status = document.createElement("section");
        status.className =
          "mx-auto my-8 w-[calc(100%-2.5rem)] max-w-3xl rounded-[1.75rem] border border-[#b34b25]/25 bg-white p-6 text-[#12324a] shadow-[0_20px_60px_rgba(18,50,74,0.08)] sm:p-8";
        status.setAttribute("role", "alert");
        status.setAttribute("tabindex", "-1");

        const heading = document.createElement("h2");
        heading.className =
          "font-heading text-2xl font-semibold tracking-[-0.04em]";
        heading.textContent = "No pudimos iniciar esta pantalla";

        const description = document.createElement("p");
        description.className = "mt-2 max-w-prose text-sm leading-6 text-[#587080]";
        description.textContent =
          "La aplicación no terminó de cargar. Recarga la página para intentarlo nuevamente.";

        const reloadButton = document.createElement("button");
        reloadButton.className =
          "mt-5 min-h-11 rounded-full bg-[#12324a] px-5 text-sm font-semibold text-white hover:bg-[#1d4b68] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/30";
        reloadButton.type = "button";
        reloadButton.textContent = "Recargar página";
        reloadButton.addEventListener("click", () => window.location.reload());

        status.append(heading, description, reloadButton);
        island.replaceChildren(status);
        status.focus();
      });
    </script>
  </head>
  <body>
    <a
      class="sr-only fixed left-4 top-4 z-50 rounded-full bg-[#12324a] px-4 py-3 text-sm font-semibold text-white focus:not-sr-only focus:outline-none focus:ring-4 focus:ring-[#e76832]/35"
      href="#main-content"
    >
      Saltar al contenido principal
    </a>
    <div class="relative min-h-screen overflow-x-hidden bg-[#f4f0e8] text-[#12324a]">
      <div class="pointer-events-none absolute -left-32 top-24 size-80 rounded-full bg-[#e76832]/10 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-36 top-0 size-[28rem] rounded-full bg-[#338faa]/15 blur-3xl" aria-hidden="true"></div>
      <slot />
    </div>
  </body>
</html>
