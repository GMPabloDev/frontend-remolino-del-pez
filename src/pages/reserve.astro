---
import { restaurantBrand } from "../config/restaurant-brand";
import { PublicReservationApp } from "../features/public-reservation/PublicReservationApp";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={`${restaurantBrand.name} · Reserva temporal`}
  description={`Consulta disponibilidad y crea una reserva temporal en ${restaurantBrand.name}.`}
  robots="noindex, nofollow"
>
  <header class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 pb-7 pt-5 sm:px-8 sm:pb-9 sm:pt-7 lg:px-12">
    <a class="group inline-flex items-center gap-3 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/25" href="/">
      <span class="grid size-14 place-items-center overflow-hidden rounded-2xl bg-white shadow-[0_12px_30px_rgba(18,50,74,0.12)] transition-transform duration-300 group-hover:-rotate-3 sm:size-16">
        <img class="size-full object-cover" src={restaurantBrand.logoPath} alt="" />
      </span>
      <span class="hidden sm:block">
        <span class="block font-heading text-xl font-semibold tracking-[-0.04em] text-[#12324a]">{restaurantBrand.name}</span>
        <span class="mt-0.5 block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-[#12324a]/50">{restaurantBrand.slogan}</span>
      </span>
      <span class="sr-only">Ir al inicio</span>
    </a>
    <a class="rounded-full px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-[#12324a]/65 underline decoration-[#e76832]/50 decoration-2 underline-offset-4 transition-colors hover:text-[#e76832] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/25" href="/">
      Cambiar sucursal
    </a>
  </header>

  <section class="mx-auto max-w-4xl px-5 pb-2 sm:px-8 sm:pb-4">
    <h1 class="max-w-3xl font-heading text-[clamp(2.65rem,8vw,4.75rem)] font-semibold leading-[0.94] tracking-[-0.04em] text-[#12324a]">
      Reserva una mesa para tu <em class="font-normal text-[#e76832]">momento.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-7 text-[#587080] sm:text-lg sm:leading-8">
      Elige fecha, horario y completa tus datos. Te acompañamos paso a paso hasta confirmar el pago.
    </p>
  </section>

  <PublicReservationApp client:load />

  <footer class="mx-auto flex max-w-6xl flex-col gap-3 border-t border-[#12324a]/15 px-5 py-8 text-xs text-[#587080] sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
    <p class="font-heading text-lg font-semibold tracking-[-0.03em] text-[#12324a]">{restaurantBrand.name}</p>
    <p>Tu reserva se confirma al completar el pago.</p>
  </footer>
</Layout>
