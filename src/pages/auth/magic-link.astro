---
import { restaurantBrand } from "../../config/restaurant-brand";
import { CustomerMagicLinkApp } from "../../features/customer-auth/CustomerMagicLinkApp";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title={`${restaurantBrand.name} · Acceso seguro`}
  description="Validación del enlace seguro de acceso del cliente."
  robots="noindex, nofollow"
  referrerPolicy="no-referrer"
>
  <script>
    import { bootstrapCustomerMagicLink } from "../../features/customer-auth/magic-link/customer-magic-link-bootstrap";

    bootstrapCustomerMagicLink();
  </script>

  <header class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 pb-8 pt-6 sm:px-8 sm:pb-10 sm:pt-8 lg:px-12">
    <a class="group inline-flex items-center gap-3 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/25" href="/">
      <span class="grid size-14 place-items-center overflow-hidden rounded-2xl bg-white shadow-[0_12px_30px_rgba(18,50,74,0.12)] transition-transform duration-300 group-hover:-rotate-3 sm:size-16">
        <img class="size-full object-cover" src={restaurantBrand.logoPath} alt="" />
      </span>
      <span class="hidden sm:block">
        <span class="block font-heading text-xl font-semibold tracking-[-0.04em] text-[#12324a]">{restaurantBrand.name}</span>
        <span class="mt-0.5 block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-[#12324a]/50">{restaurantBrand.slogan}</span>
      </span>
      <span class="sr-only">Ir al inicio</span>
    </a>
    <a class="rounded-full px-3 py-2 text-xs font-bold uppercase tracking-[0.12em] text-[#12324a]/65 underline decoration-[#e76832]/50 decoration-2 underline-offset-4 transition-colors hover:text-[#e76832] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/25" href="/customer/access">
      Solicitar otro enlace
    </a>
  </header>

  <CustomerMagicLinkApp client:load />

  <footer class="mx-auto mt-8 flex max-w-6xl flex-col gap-3 border-t border-[#12324a]/15 px-5 py-8 text-xs text-[#12324a]/55 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
    <p class="font-heading text-lg font-semibold tracking-[-0.03em] text-[#12324a]">{restaurantBrand.name}</p>
    <p>El enlace se valida de forma segura.</p>
  </footer>
</Layout>
