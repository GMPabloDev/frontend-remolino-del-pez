---
import { restaurantBrand } from "../config/restaurant-brand";
import { PublicMenuApp } from "../features/public-menu/PublicMenuApp";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title={`${restaurantBrand.name} · Menú`}
	description={`${restaurantBrand.slogan}. Consulta la carta pública de ${restaurantBrand.name}.`}
>
	<header class="relative overflow-hidden bg-[#12324a] text-white">
		<div
			class="pointer-events-none absolute -right-24 -top-28 size-[27rem] rounded-full border border-white/10 sm:size-[36rem]"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute -bottom-20 -left-16 size-56 rounded-full bg-[#338faa]/20 blur-3xl"
			aria-hidden="true"
		></div>
		<div class="relative mx-auto max-w-6xl px-5 pb-12 pt-5 sm:px-8 sm:pb-16 sm:pt-7 lg:px-12">
			<div class="flex items-center justify-between gap-5">
				<a
					class="group inline-flex items-center gap-3 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/45"
					href="/"
				>
					<span class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-2xl bg-white p-1 shadow-[0_14px_35px_rgba(0,0,0,0.18)] transition-transform duration-300 group-hover:-rotate-3 sm:size-14">
						<img class="size-full object-contain" src={restaurantBrand.logoPath} alt="" />
					</span>
					<span class="hidden sm:block">
						<span class="block font-heading text-lg font-semibold tracking-[-0.04em]">{restaurantBrand.name}</span>
						<span class="mt-0.5 block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white/60">{restaurantBrand.slogan}</span>
					</span>
					<span class="sr-only">Volver a elegir sucursal</span>
				</a>
				<nav aria-label="Navegación del menú">
					<div class="flex items-center gap-2">
						<a
							class="rounded-full border border-white/20 px-3 py-2.5 text-xs font-semibold text-white/85 transition-colors hover:border-white/45 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/45 sm:px-4"
							href="/"
						>
							Cambiar sucursal
						</a>
						<a
							class="hidden rounded-full border border-white/20 px-4 py-2.5 text-xs font-semibold text-white/85 transition-colors hover:border-white/45 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/45 sm:inline-flex"
							href="/customer/access"
						>
							Acceso clientes
						</a>
					</div>
				</nav>
			</div>

			<div class="mt-14 flex max-w-5xl items-center gap-4 sm:mt-20 sm:gap-10">
				<div class="grid size-20 shrink-0 place-items-center overflow-hidden rounded-[1.5rem] bg-white p-1.5 shadow-[0_20px_45px_rgba(0,0,0,0.2)] sm:size-36 sm:rounded-[2rem] sm:p-2">
					<img
						class="size-full object-contain"
						src={restaurantBrand.logoPath}
						alt={`${restaurantBrand.name}, identidad visual`}
					/>
				</div>
				<div class="min-w-0">
					<h1 class="font-heading text-[clamp(2.7rem,8vw,6.5rem)] font-semibold leading-[0.88] tracking-[-0.08em] text-white">
						Sabor que <em class="font-normal text-[#ff966c]">viene</em> del mar.
					</h1>
					<p class="mt-6 max-w-xl text-base leading-7 text-white/72 sm:text-lg sm:leading-8">
						Explora la carta, elige tus platos y prepara tu próxima visita a la mesa.
					</p>
				</div>
			</div>
		</div>
		<div class="absolute inset-x-0 bottom-0 h-5 rounded-t-[2rem] bg-[#f4f0e8]" aria-hidden="true"></div>
	</header>

	<PublicMenuApp client:load />

	<footer class="mx-auto flex max-w-6xl flex-col gap-4 border-t border-[#12324a]/12 px-5 py-8 text-xs text-[#587080] sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
		<div>
			<p class="font-heading text-lg font-semibold tracking-[-0.03em] text-[#12324a]">{restaurantBrand.name}</p>
			<p class="mt-1">{restaurantBrand.slogan}</p>
		</div>
		<a class="w-fit rounded-full px-3 py-2 font-semibold text-[#12324a] underline decoration-[#e76832]/50 decoration-2 underline-offset-4 transition-colors hover:text-[#e76832] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/25" href="/customer/access">
			Consultar mis reservas
		</a>
	</footer>
</Layout>
