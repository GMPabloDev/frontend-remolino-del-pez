---
import { restaurantBrand } from "../config/restaurant-brand";
import { PublicDiscoveryApp } from "../features/public-discovery/PublicDiscoveryApp";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title={`${restaurantBrand.name} · Elige tu sucursal`}
	description={`Encuentra tu sucursal de ${restaurantBrand.name} y consulta su menú.`}
>
	<header class="relative overflow-hidden bg-[#12324a] text-white">
		<div
			class="pointer-events-none absolute -right-24 -top-32 size-[28rem] rounded-full border border-white/10 sm:size-[38rem]"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute -right-8 top-12 size-56 rounded-full bg-[#e76832]/15 blur-3xl sm:size-72"
			aria-hidden="true"
		></div>
		<div class="relative mx-auto max-w-6xl px-5 pb-12 pt-5 sm:px-8 sm:pb-20 sm:pt-7 lg:px-12">
			<div class="flex items-center justify-between gap-5">
				<a
					class="group inline-flex items-center gap-3 rounded-2xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/45"
					href="/"
				>
					<span class="grid size-12 shrink-0 place-items-center overflow-hidden rounded-2xl bg-white p-1 shadow-[0_14px_35px_rgba(0,0,0,0.18)] transition-transform duration-300 group-hover:-rotate-3 sm:size-14">
						<img class="size-full object-contain" src={restaurantBrand.logoPath} alt="" />
					</span>
					<span class="hidden sm:block">
						<span class="block font-heading text-lg font-semibold tracking-[-0.04em]">{restaurantBrand.name}</span>
						<span class="mt-0.5 block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white/60">{restaurantBrand.slogan}</span>
					</span>
					<span class="sr-only">Ir al inicio</span>
				</a>
				<nav aria-label="Navegación principal">
					<a
						class="rounded-full border border-white/20 px-4 py-2.5 text-xs font-semibold text-white/85 transition-colors hover:border-white/45 hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/45"
						href="/customer/access"
					>
						Acceso clientes
					</a>
				</nav>
			</div>

			<div class="mt-16 grid items-end gap-10 sm:mt-24 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
				<div class="max-w-3xl">
					<h1 class="font-heading text-[clamp(3.5rem,10vw,7rem)] font-semibold leading-[0.86] tracking-[-0.08em] text-white">
						Tu próxima mesa
						<br />
						<em class="font-normal text-[#ff966c]">empieza aquí.</em>
					</h1>
					<p class="mt-7 max-w-xl text-base leading-7 text-white/72 sm:text-lg sm:leading-8">
						Elige una sucursal para consultar su carta, revisar la disponibilidad y reservar con calma.
					</p>
				</div>

				<div class="rounded-[1.75rem] border border-white/15 bg-white/[0.07] p-5 backdrop-blur-sm sm:p-6">
					<div class="mb-8 flex items-center justify-between gap-4">
						<span class="size-3 rounded-full bg-[#e76832] shadow-[0_0_0_6px_rgba(231,104,50,0.14)]" aria-hidden="true"></span>
						<span class="text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white/55">Reserva tu mesa</span>
					</div>
					<p class="font-heading text-2xl leading-tight tracking-[-0.04em] text-white sm:text-3xl">
						Una carta, el lugar que prefieras.
					</p>
					<p class="mt-3 text-sm leading-6 text-white/60">
						Comienza por la sucursal donde quieres disfrutarla.
					</p>
				</div>
			</div>
		</div>
		<div class="absolute inset-x-0 bottom-0 h-5 rounded-t-[2rem] bg-[#f4f0e8]" aria-hidden="true"></div>
	</header>

	<PublicDiscoveryApp client:load />

	<footer class="mx-auto flex max-w-6xl flex-col gap-4 border-t border-[#12324a]/12 px-5 py-8 text-xs text-[#587080] sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-12">
		<div>
			<p class="font-heading text-lg font-semibold tracking-[-0.03em] text-[#12324a]">{restaurantBrand.name}</p>
			<p class="mt-1">{restaurantBrand.slogan}</p>
		</div>
		<a class="w-fit rounded-full px-3 py-2 font-semibold text-[#12324a] underline decoration-[#e76832]/50 decoration-2 underline-offset-4 transition-colors hover:text-[#e76832] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#e76832]/25" href="/customer/access">
			Consultar mis reservas
		</a>
	</footer>
</Layout>
